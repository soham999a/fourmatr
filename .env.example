# Mail delivery — choose one provider.
# If neither is configured, the contact API logs the correspondence server-side
# and tells the sender to mail system@matrka.net.

# Option A: Resend
RESEND_API_KEY=
MAIL_FROM="Matrka Applied Systems <onboarding@resend.dev>"
MAIL_TO=system@matrka.net

# Option B: SMTP (used only when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
